{
  "name": "api-client",
  "version": "0.1.0",
  "description": "API Client: build, send, test and organize HTTP requests in your browser, with optional sync to your Puter cloud.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
