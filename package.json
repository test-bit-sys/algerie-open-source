{
  "name": "algerie-open-source",
  "version": "1.1.0",
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "description": "DZ Open Suite — The Algerian National Open-Source Software Ecosystem. Modern, 100% offline-first, trilingual (AR/FR/EN) software alternatives for Algeria.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:dz-facture": "node apps/business-enterprise/dz-facture/server.js",
    "test": "node --check server.js && node --check apps/productivity/dz-disk-tree/server.js && node --check apps/productivity/dz-archive/server.js && node --check apps/multimedia/dz-player/server.js && node --check apps/office-suite/dz-pdf/server.js && node --test apps/business-enterprise/dz-facture/tests/*.test.js",
    "start:disk-tree": "node apps/productivity/dz-disk-tree/server.js",
    "start:archive": "node apps/productivity/dz-archive/server.js",
    "start:player": "node apps/multimedia/dz-player/server.js",
    "start:pdf": "node apps/office-suite/dz-pdf/server.js",
    "dev:archive": "npx vite apps/productivity/dz-archive",
    "dev:player": "npx vite apps/multimedia/dz-player",
    "dev:pdf": "npx vite apps/office-suite/dz-pdf",
    "build:archive": "npx vite build apps/productivity/dz-archive"
  },
  "keywords": [
    "algeria",
    "dz",
    "dz-open-suite",
    "algerian-software",
    "open-source",
    "facturation",
    "invoicing",
    "pos",
    "point-of-sale",
    "cash-register",
    "erp",
    "tafqit",
    "dinar",
    "dzd",
    "fiscal",
    "tva",
    "accounting",
    "offline-first",
    "trilingual",
    "arabic"
  ],
  "author": "Algeria Open Source Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/test-bit-sys/algerie-open-source.git"
  },
  "bugs": {
    "url": "https://github.com/test-bit-sys/algerie-open-source/issues"
  },
  "homepage": "https://github.com/test-bit-sys/algerie-open-source#readme"
}
